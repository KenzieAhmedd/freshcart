# Base URL of the Route e-commerce REST API (no trailing slash, includes /api/v1)
NEXT_PUBLIC_API_URL=https://ecommerce.routemisr.com/api/v1

# Public URL of THIS site. Used as the ?url= return address for online payment (Stripe).
# Local dev: http://localhost:3000   Production: your deployed origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000
